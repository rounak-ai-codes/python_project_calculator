a = float(input("enter the first number"))
b = float(input("enter the second number"))
op = input("+,-,*,**,/,%")

if op == "+":
    print(a+b)
    
elif op == "-":
    print(a-b)
    
elif op == "*":
    print(a*b)
    
elif op == "**":
    print(a**b)
    
elif op == "a%B":
    print(a%b)
    
    
else:
    print("end of the file")